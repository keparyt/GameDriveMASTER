TOKEN = ""


# Home LAN connection configuration

LAN_WEB_HOST = "0.0.0.0"
LAN_WEB_PORT = 9999

# URL users will receive from Discord.
LAN_BASE_URL = "http://192.168.28.7:9999"

# Your home LAN subnet.
LAN_NETWORK = "192.168.28.0/24"

# Discord role that users receive while connected.
HOME_ROLE_ID = 0

# Seconds before a connection is considered dead.
LAN_CONNECTION_TIMEOUT = 600


# Reel Minecraft mod parser
# These are environment variables rather than hard-coded secrets.
# OLLAMA_VISION_MODEL should be a small vision model suitable for a GTX 1660 SUPER.
# Example: qwen2.5vl:3b
# OLLAMA_TEXT_MODEL is used to combine caption/audio/visual clues.
# Example: qwen2.5:3b
# CURSEFORGE_API_KEY is optional; Modrinth verification works without it.
